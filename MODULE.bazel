"""swift_sqlite: SQLite for Swift on every platform, the C API as the
module CSQLite and a thin Swift layer over it as SwiftSQLite.

Apple's platforms link the system's SQLite; the others (Linux, Android,
Windows, WebAssembly) build SQLite's amalgamation, vendored under
Sources/CSQLite/amalgamation, with the options in Sources/CSQLite/csqlite.c,
so that Bazel and SwiftPM (Package.swift) build the same SQLite.
"""

module(
    name = "swift_sqlite",
    version = "0.34",
)

# The lowest versions this builds with: a consumer's own (or its overrides)
# win under Bazel's version selection.
bazel_dep(name = "platforms", version = "1.1.0")

# apple_support before rules_cc, or rules_cc's local darwin toolchain (no
# target triple) outranks it on a Mac and Swift compiles fail with "Invalid
# target triple: local".
bazel_dep(name = "apple_support", version = "2.6.1")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_swift", version = "3.6.1")
